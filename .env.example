# Copy this file to ".env.local" and fill in the real values.
# .env.local is listed in .gitignore, so it will NEVER be uploaded to GitHub.
# NEVER put real keys in this .env.example file - it IS uploaded.

# Your RustMaps API key (from https://rustmaps.com/dashboard).
# Only used on the server. Leave empty to use demo mode only.
RUSTMAPS_API_KEY=
