# Copy this file to ".env.local" and fill in the real values.
# .env.local is listed in .gitignore, so it will NEVER be uploaded to GitHub.
# NEVER put real keys or passwords in this .env.example file - it IS uploaded.
#
# Without the Supabase values below, only the demo map works.

# --- Supabase (Project Settings → API Keys / Data API in the Supabase dashboard) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co  (not secret)
NEXT_PUBLIC_SUPABASE_URL=
# SECRET key (starts with sb_secret_ … or the older "service_role" key).
# Full database access: server only, never share it, never commit it.
SUPABASE_SECRET_KEY=
